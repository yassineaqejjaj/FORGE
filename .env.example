# FORGE — copy to .env and adjust. Every variable is documented in docs/ARCHITECTURE.md §1.

# Runtime: development | production | test (production refuses the development secrets below)
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO
FORGE_PUBLIC_BASE_URL=http://localhost:8100

# Secrets (CHANGE IN PRODUCTION — at least 32 characters each)
FORGE_JWT_SECRET=forge-dev-secret-change-me-0123456789abcdef
FORGE_SECRETS_KEY=forge-dev-secrets-key-change-me-0123456789
FORGE_COOKIE_SECURE=false

# Bootstrap administrator (created when the database has no user)
FORGE_BOOTSTRAP_ADMIN_EMAIL=admin@forge.local
FORGE_BOOTSTRAP_ADMIN_PASSWORD=forge-admin

# Optional LLM providers: judges and credentials are created at start-up when a key is set.
FORGE_OPENAI_API_KEY=
FORGE_OPENAI_BASE_URL=https://api.openai.com/v1
FORGE_OPENAI_JUDGE_MODEL=gpt-5-mini
FORGE_ANTHROPIC_API_KEY=
FORGE_ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001

# Optional LLM synthesising feedback reports (OpenAI-compatible); deterministic otherwise.
FORGE_FEEDBACK_LLM_BASE_URL=
FORGE_FEEDBACK_LLM_MODEL=
FORGE_FEEDBACK_LLM_API_KEY=

# Optional ORBIT integration (context snapshots / live context for agents)
FORGE_ORBIT_BASE_URL=

# FORGE's own telemetry (OTLP/HTTP collector, Tempo, Jaeger…)
FORGE_OTLP_ENDPOINT=
FORGE_OTLP_HEADERS=

# Workers
FORGE_RUNNER_CONCURRENCY=8
FORGE_EVALUATION_CONCURRENCY=4
